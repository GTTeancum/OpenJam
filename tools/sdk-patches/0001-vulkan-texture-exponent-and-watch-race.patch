+bool SharedMemory::AreAllPagesValid(const std::unique_lock<std::recursive_mutex>& global_lock,
+                                    uint32_t start, uint32_t length) const {
+  if (length == 0 || start >= kBufferSize) {
+    return true;
+  }
+  length = std::min(length, kBufferSize - start);
+  uint32_t page_first = start >> page_size_log2_;
+  uint32_t page_last = (start + length - 1) >> page_size_log2_;
+  for (uint32_t i = page_first >> 6; i <= page_last >> 6; ++i) {
+    uint64_t needed = UINT64_MAX;
+    if (i == page_first >> 6) {
+      needed &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (i == page_last >> 6 && (page_last & 63) != 63) {
+      needed &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    if ((system_page_flags_valid_[i] & needed) != needed) {
+      return false;
+    }
+  }
+  return true;
+}
