+REXCVAR_DEFINE_DOUBLE(test_explicit_refresh, 60.0, "Test", "Explicit refresh override")
+    .preserve_explicit_config_default();
+
+TEST_CASE("cvar preserves opt-in explicit config defaults", "[cvar]") {
+  rex::cvar::testing::ResetAllForTesting();
+  const auto path = std::filesystem::temp_directory_path() / "test_explicit_refresh.toml";
+  CHECK(rex::cvar::SerializeToTOML().find("test_explicit_refresh") == std::string::npos);
+  {
+    std::ofstream config(path);
+    config << "test_explicit_refresh = 60.0\n"
+           << "test_int32_flag = 42\n";
+  }
+  rex::cvar::LoadConfig(path);
+  REQUIRE(rex::cvar::GetFlagSource("test_explicit_refresh") == rex::cvar::Source::kConfig);
+  auto serialized = rex::cvar::SerializeToTOML("Test");
+  CHECK(serialized.find("test_explicit_refresh = 60") != std::string::npos);
+  CHECK(serialized.find("test_int32_flag") == std::string::npos);
+  rex::cvar::SaveConfig(path);
+  rex::cvar::testing::ResetAllForTesting();
+  rex::cvar::LoadConfig(path);
+  CHECK(rex::cvar::GetFlagSource("test_explicit_refresh") == rex::cvar::Source::kConfig);
+  CHECK(REXCVAR_GET(test_explicit_refresh) == 60.0);
+  std::filesystem::remove(path);
+}
